# Получить у @BotFather. Не отправлять в чат и не коммитить.
BOT_TOKEN=
DATABASE_URL=postgresql://balans_app:CHANGE_ME@localhost:5432/balans
# Только для миграций; бот эту строку не использует.
MIGRATION_DATABASE_URL=postgresql://balans_owner:CHANGE_ME@localhost:5432/balans
SUPPORT_CONTACT=

# Этап 3: OpenAI Responses API; ключ отдельный от BOT_TOKEN.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AI_TIMEOUT_SECONDS=10
AI_CONFIDENCE_THRESHOLD=0.75

# Исходники чеков: приватный локальный каталог, срок хранения 30 дней.
RECEIPT_STORAGE_DIR=.local/receipts

# Этап 5: используется тот же OPENAI_API_KEY.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Этап 6: путь к JSON-ключу сервисного аккаунта Google (не содержимое ключа).
# Храните файл вне Git, например в .local/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# Этап 15: до утверждения цены/условий оставьте false.
BILLING_ENABLED=false
OWNER_TELEGRAM_ID=
SUBSCRIPTION_STARS=
TRIAL_DAYS=7
TEXT_MONTHLY_QUOTA=
VOICE_MONTHLY_SECONDS=
IMAGE_MONTHLY_QUOTA=
TERMS_URL=

# Этап 16: панель выключена до настройки владельца и TOTP.
ADMIN_ENABLED=false
ADMIN_BASE_URL=http://127.0.0.1:8088
ADMIN_PORT=8088
# Секрет Base32 из приложения аутентификации, не менее 32 символов; не передавайте в чат.
ADMIN_TOTP_SECRET=
# Дополнительные администраторы: JSON {"TELEGRAM_ID":"BASE32_SECRET"}; роли выдаются отдельно.
ADMIN_TOTP_SECRETS={}

# Этап 17: публикуются оператором под выбранные страны и правила сервиса.
PRIVACY_REQUIRED=false
PRIVACY_URL=
OPERATOR_COUNTRY=
STORAGE_COUNTRY=
PAYMENT_RETENTION_POLICY=

# Этап 18: приём и обработка. По умолчанию локальный polling.
TELEGRAM_TRANSPORT=polling
INBOX_WORKERS=4
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
# Отдельная резервная роль: только чтение всей БД, BYPASSRLS, никогда не DATABASE_URL.
BACKUP_DATABASE_URL=
BACKUP_KEY_FILE=
BACKUP_DIR=.local/backups
